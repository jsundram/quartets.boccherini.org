#!/bin/bash
#
# Pre-commit hook: PWA lints + regenerate PDF before committing.
#
# Requires this repo's hooks dir to be active:  git config core.hooksPath hooks
#
# 1. sw_lint  — warn (don't block) if a precached service-worker SHELL file changed without a V bump.
# 2. og-lint  — block if the OG share card exceeds the scraper size budget (else previews silently fail).
# 3. Regenerate print.pdf when index.html or opera.json changed.
#

set -e

# 1. Service-worker shell/version guard (warn only — a stale V won't reach installed home-screen copies).
python3 tools/sw_lint.py || echo "  (warning only — bump V in sw.js if this was a real shell change)"

# 2. OG share-card size guard (blocking — an oversized card previews as a grey box on WhatsApp/iMessage).
python3 scripts/og-lint.py

# Only run PDF regen if index.html or opera.json is being committed
if ! git diff --cached --name-only | grep -qE '^(index\.html|opera\.json)$'; then
    exit 0
fi

echo "📄 Regenerating PDF (index.html or opera.json changed)..."

# Check if server is already running
SERVER_RUNNING=false
if nc -z localhost 8000 2>/dev/null; then
    SERVER_RUNNING=true
fi

# Start server if needed
if [ "$SERVER_RUNNING" = false ]; then
    echo "   Starting local server..."
    python3 -m http.server 8000 &>/dev/null &
    SERVER_PID=$!
    sleep 1
fi

# Generate PDF
uv run tools/generate-pdf.py

# Stop server if we started it
if [ "$SERVER_RUNNING" = false ] && [ -n "$SERVER_PID" ]; then
    kill $SERVER_PID 2>/dev/null || true
fi

# Stage the updated PDF
git add print.pdf

echo "✓ PDF regenerated and staged"
